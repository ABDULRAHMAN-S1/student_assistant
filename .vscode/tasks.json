{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter-tests-secure",
      "type": "shell",
      "command": "flutter",
      "args": ["test", "test/ai_chat_page_test.dart", "test/widget_test.dart"],
      "isBackground": false,
      "group": "test"
    },
    {
      "label": "backend-unittest-security",
