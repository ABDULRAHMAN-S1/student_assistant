      "command": "${workspaceFolder}\\backend\\venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "backend/tests",
        "-p",
        "test_api_security.py",
        "-v"
      ],
      "isBackground": false,
