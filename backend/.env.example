APP_ENV=production
API_TITLE=Student Assistant API
API_VERSION=2.0.0
APP_DB_PATH=./data/app.db
LOG_LEVEL=INFO

# ── AI / Retrieval configuration ─────────────────────────────────────────────
#
# SELECTED BY BENCHMARK (60-question evaluation, 2026-04):
#   Hit@4=93.2%  MRR=0.9110  Fallback=11.9%  Latency≈464ms
#
# To apply this model for the first time, run:
#   python -m app.prepare_data
#   python -m app.embed_store --rebuild
#
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Cross-encoder reranking — benchmark showed no retrieval gain on this corpus
# and added ~1600 ms/query. Keep disabled unless corpus grows substantially.
ENABLE_RERANKING=false
RERANKING_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKING_POOL_SIZE=20

# Comma-separated HTTPS origins only in production.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Replace with a long random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

REQUIRE_HTTPS=true
# Only enable forwarded headers when you are behind a trusted reverse proxy (and configure TRUSTED_PROXY_IPS).
TRUST_FORWARDED_PROTO=false
TRUST_FORWARDED_FOR=false
# Optional: comma-separated list of proxy IPs allowed to supply X-Forwarded-For.
# If empty, any direct client can spoof X-Forwarded-For, so it is ignored.
TRUSTED_PROXY_IPS=
ENABLE_API_DOCS=false

# Leave translation disabled unless your privacy review explicitly approves it.
ENABLE_TRANSLATION=false
ALLOW_EXTERNAL_TRANSLATION=false
TRANSLATION_PROVIDER=disabled

# Optional: configure Redis for multi-instance rate limiting.
REDIS_URL=

# Push notifications (FCM)
# Keep push enabled in production and provide the full Firebase service account
# JSON as a single-line string.
NOTIFICATIONS_PUSH_ENABLED=true
FCM_SERVICE_ACCOUNT_JSON=